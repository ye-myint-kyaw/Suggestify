# Firebase web app config.
# Copy this file to .env and fill in the values from
# Firebase console → Project settings → General → Your apps → SDK setup and configuration.
#
# These values aren't secret (they ship in the browser bundle, and firestore.rules
# does the access control), but .env is kept out of git so each developer and host
# provides their own. Not needed for `yarn dev:emulators`, which uses .env.emulator.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

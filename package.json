{
  "name": "suggestify",
  "private": true,
  "version": "1.0.0",
  "description": "Collect honest, anonymous feedback with a shareable suggestion box and QR code.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-suggestify",
    "test": "firebase emulators:exec --only firestore --project demo-suggestify \"vitest run\"",
    "test:unit": "vitest run src"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@reduxjs/toolkit": "^2.13.0",
    "firebase": "^12.19.0",
    "formik": "^2.4.9",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.6",
    "scrollreveal": "^4.0.9",
    "typed.js": "^2.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^15.34.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

# Used by `yarn dev:emulators` (vite --mode emulator).
# Talks to the local Auth + Firestore emulators started with `yarn emulators`.
# "demo-" projects never touch real Firebase resources.
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-suggestify.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-suggestify
VITE_FIREBASE_APP_ID=demo-app-id
